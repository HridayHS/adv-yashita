---
import { site } from "../data/site";
---
<section id="practice" aria-labelledby="practice-heading" class="py-12 sm:py-16 px-6 relative">
  <div class="mx-auto max-w-2xl text-center flex flex-col items-center gap-4">
    <div class="h-[1px] w-12 bg-gold/30"></div>
    <h2 id="practice-heading" class="sr-only">Areas of Practice</h2>
    <p class="font-serif text-xl sm:text-2xl md:text-3xl text-white/90 leading-relaxed font-normal">
      Offering legal counsel and advocacy across all disputes, with dedicated practice in 
      <span class="text-gold font-medium">Civil Matters</span>, 
      <span class="text-gold font-medium">Family Law</span>, 
      <span class="text-gold font-medium">Commercial Disputes</span>, and 
      <span class="text-gold font-medium">Legal Documentation</span>.
    </p>
    <div class="h-[1px] w-12 bg-gold/30"></div>
  </div>
</section>
