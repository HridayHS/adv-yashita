---
import { site } from "../data/site";
---
<header class="bg-navy text-white">
  <div class="mx-auto max-w-2xl px-6 py-14 flex flex-col items-center text-center gap-3">
    <h1 class="font-serif text-4xl font-bold leading-tight">{site.name}</h1>
    <div class="flex flex-col gap-1">
      <p class="text-white/90 font-sans text-base">
        {site.designation}
      </p>
      <p class="text-white/70 font-sans text-sm">
        Enrolled with the {site.enrolmentBody}
      </p>
    </div>
  </div>
</header>

