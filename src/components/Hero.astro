---
import { site } from "../data/site";
---
<header class="relative pt-24 pb-8 sm:pt-32 sm:pb-12 px-6 overflow-hidden" id="hero">
  <!-- Subtle ambient glow orb behind name -->
  <div class="pointer-events-none absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[350px] sm:w-[500px] h-[350px] sm:h-[500px] bg-gradient-to-tr from-gold/10 to-indigo-900/15 rounded-full blur-[100px] -z-10" aria-hidden="true"></div>

  <div class="mx-auto max-w-3xl flex flex-col items-center text-center gap-6">
    
    <!-- Display Title -->
    <h1 class="font-serif text-5xl sm:text-7xl md:text-8xl font-bold tracking-tight text-transparent bg-clip-text bg-gradient-to-b from-white via-[#f4f4f6] to-[#9fa6b8] leading-[1.05]">
      {site.name}
    </h1>
    
    <!-- Clean, Prestigious Title & Bar Council Line -->
    <div class="flex flex-wrap items-center justify-center gap-2.5 sm:gap-3 text-center">
      <span class="font-sans text-xs sm:text-sm tracking-[0.22em] uppercase text-gold font-medium">
        {site.designation}
      </span>
      <span class="text-gold/40 text-xs select-none">·</span>
      <span class="font-sans text-xs sm:text-sm text-white/75 font-light tracking-wide">
        Enrolled with the {site.enrolmentBody}
      </span>
    </div>

  </div>
</header>
