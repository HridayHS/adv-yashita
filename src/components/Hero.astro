---
import { site } from "../data/site";
---
<header class="relative pt-20 pb-12 sm:pt-28 sm:pb-16 px-6 overflow-hidden" id="hero">
  <!-- Subtle ambient glow orb behind name -->
  <div class="pointer-events-none absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[350px] sm:w-[500px] h-[350px] sm:h-[500px] bg-gradient-to-tr from-gold/10 to-indigo-900/15 rounded-full blur-[100px] -z-10" aria-hidden="true"></div>

  <div class="mx-auto max-w-3xl flex flex-col items-center text-center gap-7">
    
    <!-- Chamber Status Badge with breathing indicator -->
    <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full border border-gold/25 bg-gold/[0.04] backdrop-blur-md shadow-[0_0_20px_rgba(229,195,120,0.08)]">
      <span class="relative flex h-2 w-2">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-400"></span>
      </span>
      <span class="font-sans text-xs font-medium tracking-wider uppercase text-gold-light/90">
        Chambers in Delhi · {site.enrolmentBody}
      </span>
    </div>

    <!-- Kinetic Display Title -->
    <div class="flex flex-col items-center gap-3">
      <h1 class="font-serif text-5xl sm:text-7xl md:text-8xl font-bold tracking-tight text-transparent bg-clip-text bg-gradient-to-b from-white via-[#f4f4f6] to-[#9fa6b8] leading-[1.05]">
        {site.name}
      </h1>
      
      <div class="flex items-center gap-3.5 mt-1">
        <div class="h-[1px] w-6 sm:w-10 bg-gold/50"></div>
        <p class="font-sans text-xs sm:text-sm tracking-[0.25em] uppercase text-gold font-medium">
          {site.designation} · {site.enrolmentNumber}
        </p>
        <div class="h-[1px] w-6 sm:w-10 bg-gold/50"></div>
      </div>
    </div>

    <!-- Authoritative Practice Summary -->
    <p class="max-w-xl font-sans text-sm sm:text-base text-muted leading-relaxed font-light">
      Strategic legal advocacy, dispute resolution, and contractual drafting before Trial and Appellate Courts across the National Capital Region.
    </p>

  </div>
</header>
