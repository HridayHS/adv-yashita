---
import { site } from "../data/site";
---
<header class="bg-navy text-white" id="hero">
  <div class="mx-auto max-w-2xl px-6 py-16 sm:py-24 flex flex-col items-center text-center gap-6">
    <h1 class="font-serif text-[3rem] sm:text-[4.5rem] font-bold leading-none tracking-tight">{site.name}</h1>
    <div class="w-24 h-[1px] bg-gold"></div>
    <div class="flex flex-col gap-2">
      <p class="text-white/80 font-sans text-base sm:text-lg">{site.designation}</p>
      <p class="text-white/60 font-sans text-sm">Enrolled with the {site.enrolmentBody}</p>

    </div>
  </div>
</header>
