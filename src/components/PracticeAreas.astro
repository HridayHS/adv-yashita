---
import { site } from "../data/site";
---
<section id="practice" aria-labelledby="practice-heading" class="py-14 px-6 bg-surface">
  <div class="mx-auto max-w-2xl">
    <h2 id="practice-heading" class="font-serif text-3xl font-semibold text-navy mb-10">Areas of Practice</h2>
    <ul role="list" class="space-y-6">
      <li class="border-l-2 border-gold pl-4 py-2">
        <h3 class="font-serif text-[1.25rem] font-semibold text-navy mb-1.5">Civil matters</h3>
        <p class="font-sans text-sm text-muted leading-relaxed">{site.areas.civil}</p>
      </li>
      <li class="border-l-2 border-gold pl-4 py-2">
        <h3 class="font-serif text-[1.25rem] font-semibold text-navy mb-1.5">Family matters</h3>
        <p class="font-sans text-sm text-muted leading-relaxed">{site.areas.family}</p>
      </li>
      <li class="border-l-2 border-gold pl-4 py-2">
        <h3 class="font-serif text-[1.25rem] font-semibold text-navy mb-1.5">Commercial matters</h3>
        <p class="font-sans text-sm text-muted leading-relaxed">{site.areas.commercial}</p>
      </li>
      <li class="border-l-2 border-gold pl-4 py-2">
        <h3 class="font-serif text-[1.25rem] font-semibold text-navy mb-1.5">Documentation</h3>
        <p class="font-sans text-sm text-muted leading-relaxed">{site.areas.documentation}</p>
      </li>
    </ul>
  </div>
</section>
