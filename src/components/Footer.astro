---
import { site } from "../data/site";
const year = new Date().getFullYear();
---
<footer class="bg-navy text-white/60 py-10 px-6 border-t border-white/10">
  <div class="mx-auto max-w-2xl flex flex-col items-center gap-3 text-center font-sans text-xs leading-relaxed">
    <p class="font-serif text-base font-normal text-white">{site.name} — {site.designation}</p>
    {site.enrolmentNumber && (
      <p class="text-white/70">Enrolment: {site.enrolmentNumber}</p>
    )}
    <p class="max-w-md">
      In accordance with the rules of the Bar Council of India, this website is
      for information only and is not advertising or solicitation. Sending a
      message does not create an advocate-client relationship.
    </p>
    <p class="mt-1 text-white/50">&copy; {year} {site.name}. All rights reserved.</p>
  </div>
</footer>
