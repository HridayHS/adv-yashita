---
import { site } from "../data/site";
const whatsappText = encodeURIComponent("Hello, I found your website.");
---
<section aria-label="Direct contact options" class="relative pb-16 px-6">
  <div class="mx-auto max-w-xl flex flex-col items-center gap-4">
    
    <!-- Primary Consultation Trigger with Luxury Shimmer -->
    <a
      href={`https://wa.me/${site.whatsapp}?text=${whatsappText}`}
      target="_blank"
      rel="noopener noreferrer"
      class="group relative flex items-center justify-center gap-3 w-full sm:w-auto sm:min-w-[340px] min-h-[52px] px-8 rounded-full bg-gradient-to-r from-emerald-600 via-emerald-500 to-teal-600 text-white font-sans font-medium text-sm shadow-[0_0_25px_rgba(16,185,129,0.25)] hover:shadow-[0_0_35px_rgba(16,185,129,0.4)] active:scale-[0.98] transition-all duration-200 overflow-hidden"
      aria-label="Direct Consultation via WhatsApp"
    >
      <!-- Shimmer light reflection layer -->
      <span class="absolute inset-0 w-1/2 h-full bg-gradient-to-r from-transparent via-white/20 to-transparent -skew-x-12 animate-shimmer pointer-events-none"></span>
      
      <!-- WhatsApp SVG icon -->
      <svg class="w-5 h-5 shrink-0 transition-transform group-hover:scale-110 duration-200" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
        <path d="M12 0C5.373 0 0 5.373 0 12c0 2.128.558 4.122 1.529 5.857L0 24l6.335-1.509A11.945 11.945 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.796 9.796 0 01-5.031-1.389l-.36-.214-3.761.896.946-3.669-.235-.376A9.797 9.797 0 012.182 12C2.182 6.57 6.57 2.182 12 2.182c5.43 0 9.818 4.388 9.818 9.818 0 5.43-4.388 9.818-9.818 9.818z"/>
      </svg>
      <span>Direct WhatsApp Consultation</span>
    </a>

    <!-- Secondary Frosted Pill Dock -->
    <div class="flex flex-wrap items-center justify-center gap-2.5 w-full pt-1">
      <a
        href={`tel:${site.phone}`}
        class="flex items-center gap-2 px-4 py-2.5 rounded-full border border-white/10 bg-white/[0.03] hover:bg-white/[0.08] hover:border-gold/40 text-muted hover:text-white text-xs font-sans tracking-wide transition-all duration-200 backdrop-blur-md active:scale-95"
      >
        <svg class="w-3.5 h-3.5 text-gold/80" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2a1 1 0 011.01-.24c1.12.37 2.33.57 3.58.57a1 1 0 011 1V20a1 1 0 01-1 1C9.61 21 3 14.39 3 6a1 1 0 011-1h3.5a1 1 0 011 1c0 1.25.2 2.45.57 3.57a1 1 0 01-.24 1.01l-2.21 2.21z"/>
        </svg>
        <span>Call</span>
      </a>

      <a
        href={`mailto:${site.email}`}
        class="flex items-center gap-2 px-4 py-2.5 rounded-full border border-white/10 bg-white/[0.03] hover:bg-white/[0.08] hover:border-gold/40 text-muted hover:text-white text-xs font-sans tracking-wide transition-all duration-200 backdrop-blur-md active:scale-95"
      >
        <svg class="w-3.5 h-3.5 text-gold/80" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M20 4H4a2 2 0 00-2 2v12a2 2 0 002 2h16a2 2 0 002-2V6a2 2 0 00-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
        </svg>
        <span>Email</span>
      </a>

      <a
        href={`https://instagram.com/${site.instagram}`}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-2 px-4 py-2.5 rounded-full border border-white/10 bg-white/[0.03] hover:bg-white/[0.08] hover:border-gold/40 text-muted hover:text-white text-xs font-sans tracking-wide transition-all duration-200 backdrop-blur-md active:scale-95"
      >
        <svg class="w-3.5 h-3.5 text-gold/80" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
        </svg>
        <span>Instagram</span>
      </a>

      <a
        href="#contact"
        class="flex items-center gap-2 px-4 py-2.5 rounded-full border border-gold/30 bg-gold/[0.05] hover:bg-gold/[0.12] hover:border-gold/60 text-gold-light hover:text-white text-xs font-sans tracking-wide transition-all duration-200 backdrop-blur-md active:scale-95"
      >
        <span>Send Inquiry ↓</span>
      </a>
    </div>

  </div>
</section>
